rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 200 &&
        data.email is string && data.email.size() <= 200;
    }

    function isValidInspection(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.productName is string && data.productName.size() <= 500 &&
        data.complianceScore is number;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(request.resource.data);
      allow delete: if true;
    }

    // Inspections
    match /inspections/{inspectionId} {
      allow read: if true;
      allow create, update: if isValidInspection(request.resource.data);
      allow delete: if true;
    }
  }
}

