# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Real-Time Email OTP Verification (SMTP)
# OPTION 1 (RECOMMENDED FOR ALL GMAILS - NO CUSTOM DOMAIN NEEDED):
# Use Gmail SMTP with a 16-character Google App Password (free, up to 500 emails/day to ANY email address):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_name@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM="LabelLens Verification <your_name@gmail.com>"

# OPTION 2: Brevo (formerly Sendinblue - free 300 emails/day to ANY email address):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_account_email@domain.com
# SMTP_PASS=your_brevo_smtp_key
# SMTP_FROM="LabelLens Verification <your_brevo_account_email@domain.com>"

# OPTION 3: Resend with Custom Domain (verify your domain at resend.com/domains):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key
# SMTP_FROM="LabelLens Verification <verify@yourverifieddomain.com>"

# Current Configuration:
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="DoCA LabelLens <onboarding@resend.dev>"

